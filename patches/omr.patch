+ * Exception [1] and GNU General Public License, version 2 with the
+ * OpenJDK Assembly Exception [2].
+ *
+ * [1] https://www.gnu.org/software/classpath/license.html
+ * [2] https://openjdk.org/legal/assembly-exception.html
+ *
+ * SPDX-License-Identifier: EPL-2.0 OR Apache-2.0 OR GPL-2.0-only WITH Classpath-exception-2.0 OR GPL-2.0-only WITH OpenJDK-assembly-exception-1.0
+ *******************************************************************************/
+
+#if !defined(OMRIOSFRAMEWORK_H)
+#define OMRIOSFRAMEWORK_H
+
+/*
+ * iOS apps may only ship native code as frameworks, so every runtime library
+ * "libfoo.dylib" is packaged as "<Frameworks>/foo.framework/foo", where
+ * <Frameworks> is the directory holding the runtime's own frameworks.
+ *
+ * omr_ios_map_library_path() rewrites a library name or path to that location.
+ * It returns 1 and fills buf when the name has the form [dir/]libfoo.dylib,
+ * the named file does not exist, and the framework binary does exist;
+ * otherwise it returns 0. The output buffer may be modified on failure.
+ */
+#if defined(OMR_OS_IOS)
+
+#include <dlfcn.h>
+#include <stdio.h>
+#include <string.h>
+#include <unistd.h>
+
+static inline int
+omr_ios_map_library_path(const char *name, char *buf, size_t bufLen)
+{
+	static const char prefix[] = "lib";
+	static const char suffix[] = ".dylib";
+	const size_t prefixLen = sizeof(prefix) - 1;
+	const size_t suffixLen = sizeof(suffix) - 1;
+	const char *base = NULL;
+	size_t baseLen = 0;
+	size_t stemLen = 0;
+	Dl_info info;
+	const char *selfPath = NULL;
+	const char *end = NULL;
+	int dirLen = 0;
+	int written = 0;
+
+	if ((NULL == name) || (NULL == buf)) {
+		return 0;
+	}
+	base = strrchr(name, '/');
+	base = (NULL == base) ? name : base + 1;
+	baseLen = strlen(base);
+	if ((baseLen <= (prefixLen + suffixLen))
+		|| (0 != strncmp(base, prefix, prefixLen))
+		|| (0 != strcmp(base + baseLen - suffixLen, suffix))
+	) {
+		return 0;
+	}
+	if ((base != name) && (0 == access(name, F_OK))) {
+		/* An explicit path to an existing file is used as given. */
+		return 0;
+	}
+	stemLen = baseLen - prefixLen - suffixLen;
+
+	/* This code is inlined into a runtime framework binary: <Frameworks>/x.framework/x. */
+	if ((0 == dladdr((const void *)&omr_ios_map_library_path, &info)) || (NULL == info.dli_fname)) {
+		return 0;
+	}
+	selfPath = info.dli_fname;
+	end = strrchr(selfPath, '/');
+	while ((NULL != end) && (end > selfPath)) {
+		/* Walk up to the directory that contains the enclosing ".framework" directory. */
+		const char *dirStart = end - 1;
+		while ((dirStart > selfPath) && ('/' != *dirStart)) {
+			dirStart -= 1;
+		}
+		if (((size_t)(end - dirStart) > 10) && (0 == strncmp(end - 10, ".framework", 10))) {
+			end = dirStart;
+			break;
+		}
+		end = (dirStart > selfPath) ? dirStart : NULL;
+	}
+	if (NULL == end) {
+		return 0;
+	}
+	dirLen = (int)(end - selfPath);
+	written = snprintf(buf, bufLen, "%.*s/%.*s.framework/%.*s",
+			dirLen, selfPath, (int)stemLen, base + prefixLen, (int)stemLen, base + prefixLen);
+	if ((written < 0) || ((size_t)written >= bufLen)) {
+		return 0;
+	}
+	return (0 == access(buf, F_OK)) ? 1 : 0;
+}
+
+#endif /* defined(OMR_OS_IOS) */
+
+#endif /* !defined(OMRIOSFRAMEWORK_H) */
