+ *******************************************************************************/
+
+#if !defined(OMRSYSVIOS_H)
+#define OMRSYSVIOS_H
+
+/*
+ * Sandboxed iOS apps may not use SysV IPC: shmget() raises SIGSYS instead of
+ * failing. Include this header after <sys/ipc.h>, <sys/sem.h> and <sys/shm.h>
+ * to route every SysV call to a stub that fails with ENOSYS, so callers take
+ * their normal error paths.
+ */
+#if defined(OMR_OS_IOS)
+
+#include <errno.h>
+#include <stddef.h>
+#include <sys/ipc.h>
+#include <sys/sem.h>
+#include <sys/shm.h>
+
+static inline key_t omr_iosFtok(const char *path, int id) { errno = ENOSYS; return (key_t)-1; }
+static inline int omr_iosSemget(key_t key, int nsems, int semflg) { errno = ENOSYS; return -1; }
+static inline int omr_iosShmget(key_t key, size_t size, int shmflg) { errno = ENOSYS; return -1; }
+static inline int omr_iosSemctl(int semid, int semnum, int cmd, ...) { errno = ENOSYS; return -1; }
+static inline int omr_iosSemop(int semid, struct sembuf *sops, size_t nsops) { errno = ENOSYS; return -1; }
+static inline int omr_iosShmctl(int shmid, int cmd, struct shmid_ds *buf) { errno = ENOSYS; return -1; }
+static inline void *omr_iosShmat(int shmid, const void *shmaddr, int shmflg) { errno = ENOSYS; return (void *)-1; }
+static inline int omr_iosShmdt(const void *shmaddr) { errno = ENOSYS; return -1; }
+
+#define ftok omr_iosFtok
+#define semget omr_iosSemget
+#define shmget omr_iosShmget
+#define semctl omr_iosSemctl
+#define semop omr_iosSemop
+#define shmctl omr_iosShmctl
+#define shmat omr_iosShmat
+#define shmdt omr_iosShmdt
+
+#endif /* defined(OMR_OS_IOS) */
+
+#endif /* !defined(OMRSYSVIOS_H) */
