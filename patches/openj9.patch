+/*
+ * On iOS every library is packaged as <Frameworks>/<name>.framework/<name> and the
+ * runtime resources (lib/modules, conf, ...) live in jvm.framework/javahome unless
+ * -Djava.home=<dir> is passed to JNI_CreateJavaVM.
+ */
+#define IOS_JAVA_HOME_OPTION "-Djava.home="
+#define IOS_DEFAULT_JAVA_HOME_DIR "/javahome"
+static const char *iosJavaHomeOverride = NULL;
+#endif /* defined(OMR_OS_IOS) */
+
 #if defined(WIN32)
 #include <processenv.h>
 #include <stdlib.h>
@@ -1201,6 +1213,31 @@ preloadLibraries(void)
 #endif /* defined(AIXPPC) */
 
 	jvmDLLNameBuffer = getj9bin();
+#if defined(OMR_OS_IOS)
+	/* jvmDLLNameBuffer is <Frameworks>/jvm.framework */
+	if (NULL == iosJavaHomeOverride) {
+		j9Buffer = jvmBufferCat(NULL, jvmBufferData(jvmDLLNameBuffer));
+		j9Buffer = jvmBufferCat(j9Buffer, IOS_DEFAULT_JAVA_HOME_DIR);
+	} else {
+		j9Buffer = jvmBufferCat(NULL, iosJavaHomeOverride);
+	}
+	truncatePath(jvmBufferData(jvmDLLNameBuffer));
+	/* VM libraries are found by name in the Frameworks directory (see omr_ios_map_library_path). */
+	j9binBuffer = jvmBufferCat(NULL, jvmBufferData(jvmDLLNameBuffer));
+	j9libvmBuffer = jvmBufferCat(NULL, jvmBufferData(j9binBuffer));
+	jrebinBuffer = jvmBufferCat(NULL, jvmBufferData(j9Buffer));
+	jrebinBuffer = jvmBufferCat(jrebinBuffer, "/lib");
+	j9libBuffer = jvmBufferCat(NULL, jvmBufferData(jrebinBuffer));
+	jvmInSubdir = FALSE;
+	free(jvmDLLNameBuffer);
+	jvmDLLNameBuffer = NULL;
+
+	DBG_MSG(("j9binBuffer   = <%s>\n", jvmBufferData(j9binBuffer)));
+	DBG_MSG(("jrebinBuffer  = <%s>\n", jvmBufferData(jrebinBuffer)));
+	DBG_MSG(("j9libBuffer   = <%s>\n", jvmBufferData(j9libBuffer)));
+	DBG_MSG(("j9libvmBuffer = <%s>\n", jvmBufferData(j9libvmBuffer)));
+	DBG_MSG(("j9Buffer      = <%s>\n", jvmBufferData(j9Buffer)));
+#else /* defined(OMR_OS_IOS) */
 	j9binBuffer = jvmBufferCat(NULL, jvmBufferData(jvmDLLNameBuffer));
 
 	addToLibpath(jvmBufferData(j9binBuffer), TRUE);
@@ -1275,6 +1312,7 @@ preloadLibraries(void)
 	DBG_MSG(("j9libBuffer   = <%s>\n", jvmBufferData(j9libBuffer)));
 	DBG_MSG(("j9libvmBuffer = <%s>\n", jvmBufferData(j9libvmBuffer)));
 	DBG_MSG(("j9Buffer      = <%s>\n", jvmBufferData(j9Buffer)));
