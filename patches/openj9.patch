@@ -2007,6 +2045,20 @@ JNI_CreateJavaVM_impl(JavaVM **pvm, void **penv, void *vm_args, BOOLEAN isJITSer
 #endif /* defined(AIXPPC) || (defined(J9ZOS390) && (JAVA_SPEC_VERSION >= 21)) */
 
 	/* no tracing for this function, since it's unlikely to be used once the VM is running and the trace engine is initialized */
+#if defined(OMR_OS_IOS)
+	{
+		/* The resource directory must be known before options are parsed. The last occurrence wins, as for other -D options. */
+		JavaVMInitArgs *initArgs = (JavaVMInitArgs *)vm_args;
+		jint optionIndex = 0;
+		iosJavaHomeOverride = NULL;
+		for (optionIndex = 0; optionIndex < initArgs->nOptions; optionIndex++) {
+			const char *optionString = initArgs->options[optionIndex].optionString;
+			if ((NULL != optionString) && (0 == strncmp(optionString, IOS_JAVA_HOME_OPTION, LITERAL_STRLEN(IOS_JAVA_HOME_OPTION)))) {
+				iosJavaHomeOverride = optionString + LITERAL_STRLEN(IOS_JAVA_HOME_OPTION);
+			}
+		}
+	}
+#endif /* defined(OMR_OS_IOS) */
 	preloadLibraries();
 
 #ifdef WIN32
@@ -2738,6 +2790,15 @@ preloadLibrary(char *dllName, BOOLEAN inJVMDir)
