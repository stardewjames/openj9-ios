+package sun.font;
+
+import java.io.File;
+import sun.awt.FontConfiguration;
+
+/**
+ * File-backed font manager for headless iOS. Font registration, created fonts,
+ * strikes and shaping use the shared TrueType/FreeType/HarfBuzz implementation;
+ * no fonts are obtained from the native macOS font manager or iOS system paths.
+ */
+public final class IOSFontManager extends SunFontManager {
+    @Override
+    protected String getFontPath(boolean noType1Fonts) {
+        return getJDKFontDir();
+    }
+
+    @Override
+    protected String[] getDefaultPlatformFont() {
+        return new String[] {
+            "DejaVu Sans",
+            getJDKFontDir() + File.separator + "DejaVuSans.ttf"
+        };
+    }
+
+    @Override
+    protected FontConfiguration createFontConfiguration() {
+        return new IOSFontConfiguration(this);
+    }
+
+    @Override
+    public FontConfiguration createFontConfiguration(boolean preferLocaleFonts,
+                                                      boolean preferPropFonts) {
+        return new IOSFontConfiguration(this, preferLocaleFonts, preferPropFonts);
+    }
+}
