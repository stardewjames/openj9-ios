+
   # For xlc, the word size flag is required for correct behavior.
   # For clang/gcc, the flag is only strictly required for reduced builds, but
   # set it always where possible (x86 and ppc).
@@ -274,7 +347,12 @@ AC_DEFUN_ONCE([FLAGS_PRE_TOOLCHAIN],
     fi
   fi
 
-  if test "x$OPENJDK_TARGET_OS" = xmacosx; then
+  if test "x$OPENJDK_TARGET_OS_ENV" = "xmacosx.ios"; then
+    # The target triple selects the arch, the platform (iOS device or
+    # simulator) and the minimum iOS version. No -mmacosx-version-min must
+    # be used together with it.
+    MACHINE_FLAG="$MACHINE_FLAG -target $IOS_TARGET_TRIPLE"
+  elif test "x$OPENJDK_TARGET_OS" = xmacosx; then
     if test "x$OPENJDK_TARGET_CPU" = xaarch64; then
       MACHINE_FLAG="$MACHINE_FLAG -arch arm64"
     elif test "x$OPENJDK_TARGET_CPU" = xx86_64; then
