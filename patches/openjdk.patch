@@ -162,6 +162,76 @@ AC_DEFUN([FLAGS_SETUP_MACOSX_VERSION],
   fi
 ])
 
+# Setup the iOS target (OPENJDK_TARGET_OS_ENV=macosx.ios): the minimum iOS
+# version, whether the target is the simulator or a device, and the clang
+# target triple used for the target toolchain. Must be called after the
+# sysroot has been setup and before the target compilers are tested.
+AC_DEFUN([FLAGS_SETUP_IOS_TARGET],
+[
+  AC_ARG_WITH([ios-version-min], [AS_HELP_STRING([--with-ios-version-min],
+      [lowest iOS version the built binaries run on, only used for iOS targets @<:@15.0@:>@])])
+
+  IOS_VERSION_MIN=
+  IOS_SIMULATOR=false
+  IOS_TARGET_TRIPLE=
+
+  if test "x$OPENJDK_TARGET_OS_ENV" = "xmacosx.ios"; then
+    if test "x$OPENJDK_TARGET_CPU" != xaarch64; then
+      AC_MSG_ERROR([iOS targets are only supported for aarch64, not $OPENJDK_TARGET_CPU])
+    fi
+
+    AC_MSG_CHECKING([for lowest supported iOS version])
+    if test "x$with_ios_version_min" = x; then
+      IOS_VERSION_MIN=15.0
+    elif echo "$with_ios_version_min" | $GREP -q "^[[0-9]][[0-9]]*\(\.[[0-9]][[0-9]]*\)\{1,2\}\$"; then
+      IOS_VERSION_MIN=$with_ios_version_min
+    else
+      AC_MSG_ERROR([--with-ios-version-min format must be n.n or n.n.n, got '$with_ios_version_min'])
+    fi
+    AC_MSG_RESULT([$IOS_VERSION_MIN])
+
+    AC_MSG_CHECKING([if the iOS target is the simulator])
+    # The sysroot is authoritative; fall back to the requested sdk name.
+    case "$SYSROOT" in
+      *iPhoneSimulator*)
+        IOS_SIMULATOR=true
+        ;;
+      *iPhoneOS*)
+        IOS_SIMULATOR=false
+        ;;
+      *)
+        case "$SDK_NAME" in
+          iphonesimulator*)
+            IOS_SIMULATOR=true
+            ;;
+          iphoneos*)
+            IOS_SIMULATOR=false
+            ;;
+          *)
+            AC_MSG_RESULT([unknown])
+            AC_MSG_ERROR([Cannot determine the iOS SDK from sysroot '$SYSROOT' and sdk name '$SDK_NAME'. Use --with-sdk-name=iphoneos or --with-sdk-name=iphonesimulator])
+            ;;
+        esac
+        ;;
+    esac
+    AC_MSG_RESULT([$IOS_SIMULATOR])
+
+    if test "x$IOS_SIMULATOR" = xtrue; then
+      IOS_TARGET_TRIPLE="arm64-apple-ios$IOS_VERSION_MIN-simulator"
+    else
+      IOS_TARGET_TRIPLE="arm64-apple-ios$IOS_VERSION_MIN"
+    fi
+    AC_MSG_CHECKING([for iOS target triple])
+    AC_MSG_RESULT([$IOS_TARGET_TRIPLE])
+  elif test "x$with_ios_version_min" != x; then
+    AC_MSG_WARN([--with-ios-version-min is only used for iOS targets, ignoring])
+  fi
+
+  AC_SUBST(IOS_VERSION_MIN)
+  AC_SUBST(IOS_SIMULATOR)
+  AC_SUBST(IOS_TARGET_TRIPLE)
+])
+
 # Reset the global CFLAGS/LDFLAGS variables and initialize them with the
 # corresponding configure arguments instead
 AC_DEFUN_ONCE([FLAGS_SETUP_USER_SUPPLIED_FLAGS],
@@ -261,6 +331,9 @@ AC_DEFUN_ONCE([FLAGS_PRE_TOOLCHAIN],
   # The sysroot flags are needed for configure to be able to run the compilers
   FLAGS_SETUP_SYSROOT_FLAGS
 
