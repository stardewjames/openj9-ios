new file mode 100644
index 0000000000000000000000000000000000000000..50c527c46b75071112170c5a9beec9a598bcaae5
--- /dev/null
+++ b/closed/autoconf/ios-host-exec.sh
@@ -0,0 +1,160 @@
+#!/bin/sh
+# ===========================================================================
+# (c) Copyright IBM Corp. 2026 All Rights Reserved
+# ===========================================================================
+# This code is free software; you can redistribute it and/or modify it
+# under the terms of the GNU General Public License version 2 only, as
+# published by the Free Software Foundation.
+#
+# IBM designates this particular file as subject to the "Classpath" exception
+# as provided by IBM in the LICENSE file that accompanied this code.
+#
+# This code is distributed in the hope that it will be useful, but WITHOUT
+# ANY WARRANTY; without even the implied warranty of MERCHANTABILITY or
+# FITNESS FOR A PARTICULAR PURPOSE.  See the GNU General Public License
+# version 2 for more details (a copy is included in the LICENSE file that
+# accompanied this code).
+#
+# You should have received a copy of the GNU General Public License version
+# 2 along with this work; if not, see <http://www.gnu.org/licenses/>.
+# ===========================================================================
+
+# Usage: ios-host-exec.sh <executable> [args...]
+#
+# Runs an arm64 iOS (device or simulator) build tool, e.g. OMR hookgen,
+# tracegen, tracemerge or OpenJ9 constgen, on an arm64 macOS build host.
+# These tools only use libSystem and libc++, which have the same ABI on
+# arm64 macOS. The executable and the non-system dylibs it depends on
+# (resolved through @rpath, @loader_path, @executable_path or absolute
+# paths) are copied to a temporary directory, their platform is rewritten
+# to macOS with vtool, they are ad-hoc signed and the executable is run
+# with the given arguments in the current working directory. The exit
+# status of the tool is returned.
+
+if [ $# -lt 1 ] ; then
+  echo "Usage: $0 <executable> [args...]" >&2
+  exit 2
+fi
+
+exe="$1"
+shift
+
+if [ ! -f "$exe" ] ; then
+  echo "$0: no such executable: $exe" >&2
+  exit 2
+fi
+
+if xcrun --find vtool > /dev/null 2>&1 ; then
+  VTOOL="xcrun vtool"
+elif command -v vtool > /dev/null 2>&1 ; then
+  VTOOL=vtool
+else
+  echo "$0: vtool not found (neither via xcrun nor on PATH)" >&2
+  exit 2
+fi
+
+tmpdir=`mktemp -d "${TMPDIR:-/tmp}/ios-host-exec.XXXXXX"` || exit 2
+trap 'rm -rf "$tmpdir"' EXIT
+trap 'exit 129' HUP
+trap 'exit 130' INT
+trap 'exit 143' TERM
+
+exe_dir=$(cd "$(dirname "$exe")" && pwd) || exit 2
+exe_name=$(basename "$exe")
+exe="$exe_dir/$exe_name"
+
+# Rewrite the platform of Mach-O file $1 to macOS, writing $2, and ad-hoc sign it.
+convert() {
+  $VTOOL -set-build-version macos 11.0 11.0 -replace -output "$2" "$1" || return 1
+  codesign -s - -f "$2" > /dev/null 2>&1 || return 1
+}
+
+# Print the LC_RPATH entries of Mach-O file $1.
+rpaths() {
+  otool -l "$1" | awk '/cmd LC_RPATH/ { getline; getline; print $2 }'
+}
+
+# Print the non-system dylib dependencies of Mach-O file $1.
+dependencies() {
+  otool -L "$1" | awk 'NR > 1 { print $1 }' | while read dep ; do
+    case "$dep" in
+      /usr/lib/* | /System/*) ;;
+      *) echo "$dep" ;;
+    esac
+  done
+}
+
+# Resolve dependency $1 referenced by Mach-O file $2; print the path if found.
+resolve() {
+  ref_dir=`dirname "$2"`
+  case "$1" in
+    @rpath/*)
+      leaf="${1#@rpath/}"
+      for rp in `rpaths "$2"` `rpaths "$exe"` "$ref_dir" "$exe_dir" ; do
+        case "$rp" in
+          @loader_path*) rp="$ref_dir${rp#@loader_path}" ;;
+          @executable_path*) rp="$exe_dir${rp#@executable_path}" ;;
+        esac
+        if [ -f "$rp/$leaf" ] ; then
+          echo "$rp/$leaf"
+          return 0
+        fi
+      done
+      ;;
+    @loader_path/*)
+      candidate="$ref_dir/${1#@loader_path/}"
+      ;;
+    @executable_path/*)
+      candidate="$exe_dir/${1#@executable_path/}"
+      ;;
+    /*)
+      candidate="$1"
+      ;;
+    *)
+      candidate="$exe_dir/$1"
+      ;;
+  esac
+  if [ -n "$candidate" ] && [ -f "$candidate" ] ; then
+    echo "$candidate"
+  fi
+  candidate=
+}
+
+convert "$exe" "$tmpdir/$exe_name" || {
+  echo "$0: failed to convert $exe for the macOS host" >&2
+  exit 2
+}
+
+# Convert all (transitive) non-system dylib dependencies. dyld finds them by
+# leaf name in DYLD_LIBRARY_PATH before any other location.
+pending="$tmpdir/.pending"
+seen="$tmpdir/.seen"
+echo "$exe" > "$pending"
+echo "$exe" > "$seen"
+while [ -s "$pending" ] ; do
+  current=`head -n 1 "$pending"`
+  tail -n +2 "$pending" > "$pending.tmp"
+  mv "$pending.tmp" "$pending"
+  for dep in `dependencies "$current"` ; do
+    lib=`resolve "$dep" "$current"`
+    if [ -z "$lib" ] || grep -qxF "$lib" "$seen" ; then
+      continue
+    fi
+    echo "$lib" >> "$seen"
+    lib_name=`basename "$dep"`
+    if [ "$lib" = "$current" ] || [ -f "$tmpdir/$lib_name" ] ; then
+      continue
+    fi
+    convert "$lib" "$tmpdir/$lib_name" || {
+      echo "$0: failed to convert $lib for the macOS host" >&2
+      exit 2
+    }
+    echo "$lib" >> "$pending"
+  done
+done
+
+DYLD_LIBRARY_PATH="$tmpdir${DYLD_LIBRARY_PATH:+:$DYLD_LIBRARY_PATH}"
+export DYLD_LIBRARY_PATH
+
+"$tmpdir/$exe_name" "$@"
+exit $?
