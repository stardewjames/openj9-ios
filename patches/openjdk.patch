+
+/**
+ * Stable logical fonts for the headless iOS runtime. All twelve DejaVu faces
+ * must be packaged in java.home/lib/fonts. Dialog uses Sans and DialogInput
+ * uses Sans Mono; the other two families are fallback slots, not metric slots.
+ * Additional file fonts in lib/fonts/fallback follow the bundled faces, as in
+ * the shared font configuration. Applications can also use Font.createFont
+ * and GraphicsEnvironment.registerFont without involving native platform fonts.
+ */
+final class IOSFontConfiguration extends FontConfiguration {
+    // Family order matches the first three logical families in FontConfiguration.
+    private static final String[][] FACE_NAMES = {
+        { "DejaVu Serif", "DejaVu Serif Bold",
+          "DejaVu Serif Italic", "DejaVu Serif Bold Italic" },
+        { "DejaVu Sans", "DejaVu Sans Bold",
+          "DejaVu Sans Oblique", "DejaVu Sans Bold Oblique" },
+        { "DejaVu Sans Mono", "DejaVu Sans Mono Bold",
+          "DejaVu Sans Mono Oblique", "DejaVu Sans Mono Bold Oblique" }
+    };
+    private static final String[][] FILE_NAMES = {
+        { "DejaVuSerif.ttf", "DejaVuSerif-Bold.ttf",
+          "DejaVuSerif-Italic.ttf", "DejaVuSerif-BoldItalic.ttf" },
+        { "DejaVuSans.ttf", "DejaVuSans-Bold.ttf",
+          "DejaVuSans-Oblique.ttf", "DejaVuSans-BoldOblique.ttf" },
+        { "DejaVuSansMono.ttf", "DejaVuSansMono-Bold.ttf",
+          "DejaVuSansMono-Oblique.ttf", "DejaVuSansMono-BoldOblique.ttf" }
+    };
+    private static final int[] LOGICAL_FAMILIES = { 0, 1, 2, 1, 2 };
+    private boolean initialized;
+
+    IOSFontConfiguration(SunFontManager fm) {
+        super(fm);
+        init();
+    }
+
+    IOSFontConfiguration(SunFontManager fm, boolean preferLocaleFonts,
+                         boolean preferPropFonts) {
+        // The alternate superclass constructor requires binary fontconfig
+        // tables. This configuration supplies its descriptors directly, so
+        // initialize through the standard constructor instead.
+        super(fm);
+        this.preferLocaleFonts = preferLocaleFonts;
+        this.preferPropFonts = preferPropFonts;
+        init();
+    }
+
+    @Override
+    public synchronized boolean init() {
+        if (!initialized) {
+            setFontConfiguration();
+            getInstalledFallbackFonts(SunFontManager.jreLibDirName);
+            initialized = true;
+        }
+        return true;
+    }
+
+    private static String fontFile(int family, int style) {
+        return SunFontManager.getJDKFontDir() + File.separator + FILE_NAMES[family][style];
+    }
+
+    @Override
+    public boolean fontFilesArePresent() {
+        for (int family = 0; family < FILE_NAMES.length; family++) {
+            for (int style = 0; style < NUM_STYLES; style++) {
+                if (!new File(fontFile(family, style)).isFile()) {
+                    return false;
+                }
+            }
+        }
+        return true;
+    }
+
+    @Override
+    public String getVersion() {
+        return "1";
+    }
+
+    @Override
+    public int getNumberCoreFonts() {
+        return FACE_NAMES.length * NUM_STYLES;
+    }
+
+    @Override
+    public String[] getPlatformFontNames() {
+        String[] names = new String[getNumberCoreFonts()];
+        for (int family = 0; family < FACE_NAMES.length; family++) {
+            System.arraycopy(FACE_NAMES[family], 0, names,
+                             family * NUM_STYLES, NUM_STYLES);
+        }
+        return names;
+    }
+
+    @Override
+    public String getFileNameFromPlatformName(String platformName) {
+        for (int family = 0; family < FACE_NAMES.length; family++) {
+            for (int style = 0; style < NUM_STYLES; style++) {
+                if (FACE_NAMES[family][style].equals(platformName)) {
+                    return fontFile(family, style);
+                }
+            }
+        }
+        return null;
+    }
+
+    private CompositeFontDescriptor compositeDescriptor(int fontIndex, int style) {
+        int primary = LOGICAL_FAMILIES[fontIndex];
+        int fallbackCount = installedFallbackFontFiles == null
+                ? 0 : installedFallbackFontFiles.length;
+        String[] faces = new String[FACE_NAMES.length + fallbackCount];
+        String[] files = new String[faces.length];
+        faces[0] = FACE_NAMES[primary][style];
+        files[0] = fontFile(primary, style);
+        int slot = 1;
+        for (int family = 0; family < FACE_NAMES.length; family++) {
+            if (family != primary) {
+                faces[slot] = FACE_NAMES[family][style];
+                files[slot++] = fontFile(family, style);
+            }
+        }
+        if (fallbackCount != 0) {
+            System.arraycopy(installedFallbackFontFiles, 0,
+                             files, slot, fallbackCount);
+        }
+        return new CompositeFontDescriptor(
+                publicFontNames[fontIndex] + "." + styleNames[style],
+                1, faces, files, null, null);
+    }
+
+    @Override
+    public CompositeFontDescriptor[] get2DCompositeFontInfo() {
+        CompositeFontDescriptor[] descriptors =
+                new CompositeFontDescriptor[NUM_FONTS * NUM_STYLES];
+        for (int font = 0; font < NUM_FONTS; font++) {
+            for (int style = 0; style < NUM_STYLES; style++) {
+                descriptors[font * NUM_STYLES + style] = compositeDescriptor(font, style);
+            }
+        }
+        return descriptors;
+    }
+
+    @Override
+    protected FontDescriptor[] buildFontDescriptors(int fontIndex, int styleIndex) {
+        CompositeFontDescriptor composite = compositeDescriptor(fontIndex, styleIndex);
+        String[] faces = composite.getComponentFaceNames();
+        String[] files = composite.getComponentFileNames();
+        FontDescriptor[] descriptors = new FontDescriptor[faces.length];
+        for (int slot = 0; slot < faces.length; slot++) {
+            descriptors[slot] = new FontDescriptor(
+                    faces[slot] == null ? files[slot] : faces[slot],
+                    UTF_16BE.newEncoder(), new int[0]);
+        }
+        return descriptors;
+    }
+
+    @Override
+    public String getExtraFontPath() {
+        return null; // Only the bundled directory is searched by default.
+    }
+
+    @Override
+    protected String getFaceNameFromComponentFontName(String componentFontName) {
+        return componentFontName;
+    }
+
+    @Override
+    protected String getFileNameFromComponentFontName(String componentFontName) {
+        return getFileNameFromPlatformName(componentFontName);
+    }
+
+    @Override
+    public String getFallbackFamilyName(String fontName, String defaultFallback) {
+        String compatible = getCompatibilityFamilyName(fontName);
+        return compatible == null ? defaultFallback : compatible;
+    }
+
+    @Override
+    protected Charset getDefaultFontCharset(String fontName) {
+        return UTF_16BE;
+    }
+
+    @Override
+    protected String getEncoding(String awtFontName, String characterSubsetName) {
+        return UTF_16BE.name();
+    }
+
+    @Override
+    protected void initReorderMap() {
+        // The same bundled Unicode faces are used for every startup locale.
+        reorderMap = new HashMap<>();
+    }
+}
